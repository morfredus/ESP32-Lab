<script>
async function loadNvsSummary() {
  const status = document.getElementById("nvs-summary-status");
  const table = document.getElementById("nvs-summary-table");
  const keysOutput = document.getElementById("nvs-keys-output");

  status.textContent = "Chargement de l'analyse NVS...";

  try {
    const response = await fetch("/api/nvs");

    if (!response.ok) {
      throw new Error("HTTP " + response.status);
    }

    const data = await response.json();

    const summary = data.summary || {};
    const wifi = data.wifi || {};
    const system = data.system || {};

    const rows = [];

    function addRow(label, value) {
      rows.push(
        "<tr><td>" + escapeHtml(label) +
        "</td><td>" + escapeHtml(String(value)) +
        "</td></tr>"
      );
    }

    if (wifi.station_ssid !== undefined) {
      addRow("SSID station", wifi.station_ssid);
    }

    if (wifi.access_point_ssid !== undefined) {
      addRow("SSID point d'accès", wifi.access_point_ssid);
    }

    if (wifi.station_password_present !== undefined) {
      addRow(
        "Mot de passe station",
        wifi.station_password_present ? "Présent (masqué)" : "Non détecté"
      );
    }

    if (wifi.access_point_password_present !== undefined) {
      addRow(
        "Mot de passe point d'accès",
        wifi.access_point_password_present ? "Présent (masqué)" : "Non détecté"
      );
    }

    if (system.boot_count !== undefined) {
      addRow("Compteur de démarrages", system.boot_count);
    }

    if (system.crash_count !== undefined) {
      addRow("Compteur de crashs", system.crash_count);
    }

    if (summary.valid_entries !== undefined) {
      addRow("Entrées valides", summary.valid_entries);
    }

    if (summary.unique_keys !== undefined) {
      addRow("Clés uniques", summary.unique_keys);
    }

    if (summary.rejected_entries !== undefined) {
      addRow("Entrées rejetées", summary.rejected_entries);
    }

    table.innerHTML = rows.length
      ? rows.join("")
      : "<tr><td colspan='2'>Aucune donnée de synthèse disponible</td></tr>";

    const keys = data.keys || summary.keys || {};

    keysOutput.textContent = Object.keys(keys).length
      ? Object.entries(keys)
          .map(([key, count]) => key + " (" + count + ")")
          .join("\n")
      : "Aucune clé disponible";

    status.textContent = "Analyse NVS chargée";
  } catch (error) {
    status.textContent = "Erreur : " + error.message;
    table.innerHTML =
      "<tr><td colspan='2'>Impossible de charger les données NVS</td></tr>";
    keysOutput.textContent = "";
  }
}

function escapeHtml(value) {
    
            value = String(value == null ? "" : value);value = String(value == null ? "" : value);
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

document.addEventListener("DOMContentLoaded", () => {
  loadNvsSummary();
});
</script>


