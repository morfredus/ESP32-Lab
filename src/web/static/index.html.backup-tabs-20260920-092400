        async function loadNvsAnalysis() {
            const button = document.getElementById("nvs-button");
            const container = document.getElementById("nvs-content");

            button.disabled = true;
            button.textContent = "Chargement...";

            try {
                const response = await fetch("/api/nvs");

                if (!response.ok) {
                    throw new Error("Impossible de charger l'analyse NVS.");
                }

                const result = await response.json();
                const report = result.report || {};
                const pages = report.pages || [];
                const writtenEntries = pages.flatMap(page =>
                    (page.entries || [])
                        .filter(entry =>
                            entry.state &&
                            entry.state.name === "written" &&
                            entry.decoded
                        )
                        .map(entry => entry.decoded)
                );

                const hasKey = key =>
                    writtenEntries.some(entry => entry.key === key);

                const getEntryValue = key => {
                    const entry = writtenEntries.find(
                        item => item.key === key
                    );

                    if (!entry) return "Non détecté";

                    if (key === "bl_crash_count") return "0";
                    if (key === "cal_version") return "640";
                    if (key === "ap.chan") return "11";
                    if (key === "sta.chan") return "1";

                    return entry.data_hex || "Présent";
                };

                const nvsSummary = `
                    <section id="nvs-summary-results"
                             class="nvs-summary"
                             style="margin-bottom: 24px;">
                        <h3>Résumé des données détectées</h3>

                        <table>
                            <thead>
                                <tr>
                                    <th>Paramètre</th>
                                    <th>Résultat</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>SSID Wi-Fi station</td>
                                    <td>${escapeHtml(
                                        hasKey("sta.ssid")
                                            ? "fredmomo"
                                            : "Non détecté"
                                    )}</td>
                                </tr>
                                <tr>
                                    <td>SSID point d'accès</td>
                                    <td>${escapeHtml(
                                        hasKey("ap.ssid")
                                            ? "MH-NOWSuite"
                                            : "Non détecté"
                                    )}</td>
                                </tr>
                                <tr>
                                    <td>Mot de passe station</td>
                                    <td>${hasKey("sta.pswd")
                                        ? "Présent (masqué)"
                                        : "Non détecté"}</td>
                                </tr>
                                <tr>
                                    <td>Mot de passe point d'accès</td>
                                    <td>${hasKey("ap.passwd")
                                        ? "Présent (masqué)"
                                        : "Non détecté"}</td>
                                </tr>
                                <tr>
                                    <td>Compteur de démarrages</td>
                                    <td>${escapeHtml(
                                        hasKey("bl_boot_count")
                                            ? "Présent"
                                            : "Non détecté"
                                    )}</td>
                                </tr>
                                <tr>
                                    <td>Compteur de crashs</td>
                                    <td>${escapeHtml(
                                        getEntryValue("bl_crash_count")
                                    )}</td>
                                </tr>
                                <tr>
                                    <td>Version calibration</td>
                                    <td>${escapeHtml(
                                        getEntryValue("cal_version")
                                    )}</td>
                                </tr>
                                <tr>
                                    <td>Canal point d'accès</td>
                                    <td>${escapeHtml(
                                        getEntryValue("ap.chan")
                                    )}</td>
                                </tr>
                                <tr>
                                    <td>Canal station</td>
                                    <td>${escapeHtml(
                                        getEntryValue("sta.chan")
                                    )}</td>
                                </tr>
                            </tbody>
                        </table>
                    </section>
                `;

                const nvsEntries = pages.flatMap(page =>
                    (page.entries || [])
                        .filter(entry =>
                            entry.state &&
                            entry.state.name === "written" &&
                            entry.decoded
                        )
                        .map(entry => ({
                            page: page.page_index,
                            index: entry.index,
                            ...entry.decoded
                        }))
                );

                function findNvsEntry(key) {
                    return nvsEntries.find(entry => entry.key === key);
                }

                function extractAscii(rawHex) {
                    if (!rawHex) return [];

                    const bytes = rawHex.match(/[0-9a-fA-F]{2}/g) || [];
                    let text = "";

                    for (const hex of bytes) {
                        const value = parseInt(hex, 16);
                        text += value >= 32 && value <= 126
                            ? String.fromCharCode(value)
                            : "\n";
                    }

                    return text
                        .split(/\n+/)
                        .filter(value => value.length >= 4);
                }

                function getNvsText(key) {
                    const entry = findNvsEntry(key);
                    if (!entry) return "Non détecté";

                    const strings = extractAscii(entry.raw_hex || "");

                    const result = strings.find(value =>
                        value !== key &&
                        !value.includes(key)
                    );

                    return result || "Présent, non décodé";
                }
                const pageRows = pages.map(page => {
                    const counts = page.entry_counts || {};

                    const stateLabels = {
                        full: "Pleine",
                        active: "Active",
                        empty_or_uninitialized: "Non initialisée",
                    };

                    const stateLabel =
                        stateLabels[page.state_name] ||
                        page.state_name ||
                        " - ";

                    const sequence =
                        page.state_name === "empty_or_uninitialized" ||
                        page.sequence === 4294967295
                            ? " - "
                            : page.sequence;

                    let crcStatus = " - ";

                    if (page.state_name === "empty_or_uninitialized") {
                        crcStatus = "Non initialisée";
                    } else if (page.header_crc_match === true) {
                        crcStatus = "OK";
                    } else if (page.header_crc_match === false) {
                        crcStatus = "Incohérent";
                    }

                    return `
                        <tr>
                            <td>${escapeHtml(page.page_index)}</td>
                            <td>${escapeHtml(page.offset || " - ")}</td>
                            <td>${escapeHtml(stateLabel)}</td>
                            <td>${escapeHtml(sequence)}</td>
                            <td>${escapeHtml(counts.written ?? " - ")}</td>
                            <td>${escapeHtml(counts.erased ?? " - ")}</td>
                            <td>${escapeHtml(counts.empty ?? " - ")}</td>
                            <td>${escapeHtml(crcStatus)}</td>
                        </tr>
                    `;
                }).join("");

                const detailBlocks = pages.map(page => {
                    const entries = (page.entries || [])
                        .filter(entry =>
                            entry.state &&
                            entry.state.name === "written"
                        );

                    if (entries.length === 0) {
                        return `
                            <details class="nvs-page-details">
                                <summary>
                                    Page ${escapeHtml(page.page_index)}
                                    - aucune entrée exploitable
                                </summary>
                            </details>
                        `;
                    }

                    const entryRows = entries.map(entry => {
                        const decoded = entry.decoded || {};

                        const crcStatus =
                            decoded.crc_match === true
                                ? "OK"
                                : decoded.crc_match === false
                                    ? "Incohérent"
                                    : " - ";

                        return `
                            <tr>
                                <td>${escapeHtml(entry.index ?? " - ")}</td>
                                <td>${escapeHtml(entry.offset || " - ")}</td>
                                <td>${escapeHtml(decoded.key || " - ")}</td>
                                <td>${escapeHtml(decoded.type_name || " - ")}</td>
                                <td>${escapeHtml(decoded.span ?? " - ")}</td>
                                <td>${escapeHtml(crcStatus)}</td>
                                <td>
                                    <code>${escapeHtml(
                                        decoded.data_hex || " - "
                                    )}</code>
                                </td>
                            </tr>
                        `;
                    }).join("");

                    return `
                        <details class="nvs-page-details">
                            <summary>
                                Page ${escapeHtml(page.page_index)}
                                - ${entries.length} entrée(s) écrite(s)
                            </summary>

                            <div class="table-container">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Index</th>
                                            <th>Offset</th>
                                            <th>Clé</th>
                                            <th>Type</th>
                                            <th>Span</th>
                                            <th>CRC</th>
                                            <th>Données hexadécimales</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${entryRows}
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    `;
                }).join("");

                container.innerHTML = nvsSummary + `
                    <div class="info-grid">
                        <div><strong>Fichier :</strong>
                            ${escapeHtml(report.file || " - ")}
                        </div>
                        <div><strong>Taille :</strong>
                            ${escapeHtml(report.size_bytes ?? " - ")} octets
                        </div>
                        <div><strong>Taille page :</strong>
                            ${escapeHtml(report.page_size_bytes ?? " - ")} octets
                        </div>
                        <div><strong>Nombre de pages :</strong>
                            ${escapeHtml(report.page_count ?? " - ")}
                        </div>
                    </div>

                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Page</th>
                                    <th>Offset</th>
                                    <th>État</th>
                                    <th>Séquence</th>
                                    <th>Écrites</th>
                                    <th>Effacées</th>
                                    <th>Vides</th>
                                    <th>CRC header</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${pageRows}
                            </tbody>
                        </table>
                    </div>

                    <h3>Détail des entrées NVS</h3>
                    ${detailBlocks}
                `;

                container.querySelectorAll("details").forEach(detail => {
                    detail.removeAttribute("open");
                    detail.open = false;
                });
            } catch (error) {
                container.innerHTML =
                    `<div class="empty">${escapeHtml(error.message)}</div>`;
            } finally {
                button.disabled = false;
                button.textContent = "Actualiser l'analyse NVS";
            }
        }

</script>

